<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/server_address_label"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/addressList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/scanBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_lan"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/addBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/manual_add"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/scanStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#666666"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <ProgressBar
        android:id="@+id/scanProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/localIpText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/protocol_label"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/protocol_auto"
                android:layout_marginEnd="12dp" />

            <CheckBox
                android:id="@+id/cbWebrtc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WebRTC"
                android:layout_marginEnd="12dp" />

            <CheckBox
                android:id="@+id/cbMse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MSE"
                android:layout_marginEnd="12dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <CheckBox
                android:id="@+id/cbHls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HLS"
                android:layout_marginEnd="12dp" />

            <CheckBox
                android:id="@+id/cbMjpeg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MJPEG" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/confirmBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/confirm"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
